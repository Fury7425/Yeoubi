#version 450
// SPDX-License-Identifier: MIT
// GGML_OP_ACT_QUANT mode 3 for ggml's Vulkan backend (runtime/cmake/patch_ggml.cmake):
// Yeoubi's "topk_int8" quantizer in one kernel. Keep the k largest |x| of
// each row, zero the rest, then INT8 with the row's absmax:
//   out = clamp(roundEven(v * s), -127, 127) / s,  s = (1 / max(amax, 1e-8)) * 127
// The k-th largest |x| comes from a radix select over the float bits
// (|x| >= 0, so its bit pattern orders like an unsigned integer): four
// 8-bit passes over a shared histogram, one workgroup per row, the row held
// in shared memory. Replaces ABS + TOP_K + TOP_K_MASK + the INT8 kernel.
// Values tied with the k-th are all kept (torch.topk keeps exactly k; exact
// ties of |x| are vanishingly rare in activations).

#include "generic_head.glsl"
#include "types.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};   // x   [n, rows]
layout (binding = 1) writeonly buffer D {D_TYPE data_d[];};  // out [n, rows]

layout (constant_id = 0) const uint BLOCK_SIZE = 256;

#define MAX_N 4096  // supports_op admits n <= MAX_N (16 KiB of keys)
shared uint keys[MAX_N];
shared uint hist[256];
shared uint red[BLOCK_SIZE];
shared uint sel_prefix;
shared uint sel_k;

void main() {
    const uint row = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationID.x;
    if (row >= p.KY) {
        return;  // uniform across the workgroup
    }
    const uint n    = p.KX;
    const uint k    = uint(p.param1);
    const uint base = row * n;

    uint lmax = 0u;
    for (uint i = tid; i < n; i += BLOCK_SIZE) {
        const uint key = floatBitsToUint(abs(float(data_a[base + i])));
        keys[i] = key;
        lmax = max(lmax, key);
    }
    red[tid] = lmax;
    if (tid == 0u) {
        sel_prefix = 0u;
        sel_k = k;
    }
    barrier();
    for (uint s = BLOCK_SIZE / 2u; s > 0u; s >>= 1) {
        if (tid < s) {
            red[tid] = max(red[tid], red[tid + s]);
        }
        barrier();
    }
    const uint amax_key = red[0];

    // Radix select: after each pass the top bits of the k-th largest key are fixed.
    uint fixed_mask = 0u;
    for (int shift = 24; shift >= 0; shift -= 8) {
        for (uint b = tid; b < 256u; b += BLOCK_SIZE) {
            hist[b] = 0u;
        }
        barrier();
        const uint prefix = sel_prefix;
        for (uint i = tid; i < n; i += BLOCK_SIZE) {
            const uint key = keys[i];
            if ((key & fixed_mask) == prefix) {
                atomicAdd(hist[(key >> uint(shift)) & 255u], 1u);
            }
        }
        barrier();
        if (tid == 0u) {
            uint want = sel_k, above = 0u, b = 255u;
            for (;;) {
                const uint h = hist[b];
                if (above + h >= want || b == 0u) {
                    break;
                }
                above += h;
                b--;
            }
            sel_k = want - above;
            sel_prefix = prefix | (b << uint(shift));
        }
        barrier();
        fixed_mask |= 255u << uint(shift);
    }
    const uint thr = sel_prefix;  // bit pattern of the k-th largest |x|

    const float s = (1.0 / max(uintBitsToFloat(amax_key), 1e-8)) * 127.0;
    for (uint i = tid; i < n; i += BLOCK_SIZE) {
        const float v = keys[i] >= thr ? float(data_a[base + i]) : 0.0;
        data_d[base + i] = D_TYPE(clamp(roundEven(v * s), -127.0, 127.0) / s);
    }
}
